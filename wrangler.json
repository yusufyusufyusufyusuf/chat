{
  "name": "chat",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS_DIR"
  },

  "durable_objects": {
    "bindings": [
      { "name": "Chat",    "class_name": "Chat"    },
      { "name": "Auth",    "class_name": "Auth"    },
      { "name": "Servers", "class_name": "Servers" }
    ]
  },

  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "chat-assets" }
  ],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Chat", "Auth", "Servers"]
    }
  ],

  "vars": {
    "SESSION_SECRET": "change-me-to-a-long-random-string"
  }
}
